          if (estat === 'ocupada') {
            btn.textContent = 'OCUPADA';
            btn.className   = 'btn-impressora ocupada';
            card.className  = 'impressora-card ocupada';
          } else {
            btn.textContent = 'DISPONIBLE';
            btn.className   = 'btn-impressora disponible';
            card.className  = 'impressora-card disponible';
          }
        });
      });

      function canviarImpressora(id) {
        const btn      = document.getElementById('btn-' + id);
        const nouEstat = btn.textContent.trim() === 'DISPONIBLE' ? 'ocupada' : 'disponible';
