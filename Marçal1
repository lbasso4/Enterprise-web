      let sessioActiva = false;

      function obrirLogin() {
        document.getElementById('modal-login').classList.add('actiu');
        document.body.style.overflow = 'hidden';
        actualitzarModalLogin();
      }

      function tancarLogin() {
        document.getElementById('modal-login').classList.remove('actiu');
        document.body.style.overflow = '';
        // Netejar camps i error
        document.getElementById('login-email').value = '';
        document.getElementById('login-pass').value  = '';
        document.getElementById('login-error').classList.remove('visible');
        document.getElementById('login-email').classList.remove('error');
        document.getElementById('login-pass').classList.remove('error');
      }

      function tancarLoginFons(e) {
        if (e.target === document.getElementById('modal-login')) tancarLogin();
      }

      function actualitzarModalLogin() {
        const formArea    = document.getElementById('login-form-area');
        const sessioPanel = document.getElementById('sessio-panel');
        const loginBtn    = document.getElementById('loginBtn');

        if (sessioActiva) {
          formArea.style.display    = 'none';
          sessioPanel.classList.add('visible');
          loginBtn.innerHTML        = '<i class="fa fa-circle-check"></i> Sessió activa';
          loginBtn.classList.add('sessio-activa');
        } else {
          formArea.style.display    = 'block';
          sessioPanel.classList.remove('visible');
          loginBtn.innerHTML        = '<i class="fa fa-user"></i> Login';
          loginBtn.classList.remove('sessio-activa');
        }
      }

      function intentarLogin() {
        const email = document.getElementById('login-email').value.trim().toLowerCase();
        const pass  = document.getElementById('login-pass').value;
        const errorEl = document.getElementById('login-error');

        // Cerca l'usuari
        const usuari = USUARIS.find(u =>
          u.email.toLowerCase() === email && u.password === pass
        );

        if (usuari) {
          // Login correcte
          sessioActiva = true;
          document.getElementById('nom-usuari').textContent = usuari.nom + ' (' + usuari.email + ')';
          errorEl.classList.remove('visible');
          document.getElementById('login-email').classList.remove('error');
          document.getElementById('login-pass').classList.remove('error');
          actualitzarModalLogin();
        } else {
          // Error
          errorEl.classList.add('visible');
          document.getElementById('login-email').classList.add('error');
          document.getElementById('login-pass').classList.add('error');
          // Shake animation
          const box = document.querySelector('.modal-login-box');
          box.style.animation = 'none';
          box.offsetHeight; // reflow
          box.style.animation = 'shake 0.35s ease';
        }
      }

      function tancarSessio() {
        sessioActiva = false;
        tancarLogin();
        actualitzarModalLogin();
      }

      // Permet fer login amb Enter
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && document.getElementById('modal-login').classList.contains('actiu')) {
          intentarLogin();
